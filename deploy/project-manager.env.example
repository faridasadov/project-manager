# EnvironmentFile for the systemd service (deploy/project-manager.service).
# Install to /etc/project-manager.env with strict permissions:
#   sudo install -m 600 deploy/project-manager.env.example /etc/project-manager.env
# then edit the values below. Never commit the real file — secrets live here,
# not inline in the .service unit (which is world-readable).

PORT=3000
AUTH_SECRET=change-this-to-a-long-random-secret   # openssl rand -hex 32
CORS_ORIGIN=*
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=project_manager
DB_USER=project_manager
DB_PASSWORD=change-this-db-password
DEADLINE_SCHEDULER=on
